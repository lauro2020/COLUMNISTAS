##############################################################################
# COLUMNISTAS — Variables de entorno
#
# Copia este archivo a ".env" y rellena los valores marcados con <<< >>>
#   cp .env.example .env
#
# NUNCA subas el archivo .env a GitHub: contiene tus claves.
##############################################################################

# ---------------------------------------------------------------------------
# 1. SEGURIDAD  (obligatorio cambiar antes del primer arranque)
# ---------------------------------------------------------------------------

# Clave maestra de la aplicación. Se usa para (a) firmar tu sesión y
# (b) CIFRAR las credenciales de los medios (cookies de Reforma, etc.).
# Genera una con:   openssl rand -hex 32
# ⚠ Si la cambias, las credenciales guardadas dejarán de poder leerse.
APP_SECRET_KEY=<<<cambia-esto-por-una-cadena-larga-y-aleatoria>>>

# Contraseña con la que entras a la app desde el navegador o el celular.
APP_PASSWORD=<<<tu-contraseña>>>

# Cuántos días dura la sesión iniciada antes de pedirte contraseña otra vez.
AUTH_TOKEN_DAYS=90


# ---------------------------------------------------------------------------
# 2. BASE DE DATOS Y COLA DE TRABAJOS
#    (con Docker Compose no necesitas tocar nada de esta sección)
# ---------------------------------------------------------------------------

POSTGRES_USER=columnistas
POSTGRES_PASSWORD=columnistas
POSTGRES_DB=columnistas

# Cadena de conexión que usa el backend.
DATABASE_URL=postgresql+psycopg://columnistas:columnistas@db:5432/columnistas

# Redis: cola de trabajos (recolección diaria y generación de audio).
REDIS_URL=redis://redis:6379/0


# ---------------------------------------------------------------------------
# 3. TEXTO A VOZ (TTS)
# ---------------------------------------------------------------------------

# Proveedor por defecto: "openai" (nube, de pago) o "piper" (local, gratis).
# También se puede cambiar desde la pantalla de Configuración de la app.
TTS_PROVIDER=openai

# --- Opción A: OpenAI ---
# Consigue tu clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=<<<sk-...>>>
# Modelos: gpt-4o-mini-tts (recomendado), tts-1, tts-1-hd
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voces: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
OPENAI_TTS_VOICE=onyx

# --- Opción B: Piper (local, gratis, sin internet) ---
# Carpeta donde viven los modelos .onnx de voz. Ver README, sección "Piper".
PIPER_MODEL_DIR=/data/piper
PIPER_VOICE=es_MX-ald-medium
PIPER_BINARY=piper


# ---------------------------------------------------------------------------
# 4. RECOLECCIÓN
# ---------------------------------------------------------------------------

# Hora por defecto de la recolección diaria (0-23) y zona horaria.
# Se puede cambiar después desde la app sin reiniciar nada.
COLLECT_HOUR=6
COLLECT_MINUTE=0
TIMEZONE=America/Mexico_City

# Cómo se identifica la app ante los sitios web.
USER_AGENT=ColumnistasBot/1.0 (lector personal; +https://github.com/lauro2020/columnistas)

# Segundos mínimos de espera entre dos peticiones al MISMO dominio.
REQUEST_DELAY_SECONDS=3.0
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Respetar robots.txt. Déjalo en "true" salvo que sepas lo que haces.
RESPECT_ROBOTS=true

# Usar navegador headless (Playwright) cuando el contenido requiera JavaScript.
# Requiere construir la imagen con INSTALL_PLAYWRIGHT=true (ver README).
ENABLE_HEADLESS_BROWSER=false


# ---------------------------------------------------------------------------
# 5. ALMACENAMIENTO Y RETENCIÓN
# ---------------------------------------------------------------------------

# Carpeta donde se guardan los MP3 dentro del contenedor.
AUDIO_DIR=/data/audio

# Meses de histórico que se conservan (0 = para siempre).
RETENTION_MONTHS=12


# ---------------------------------------------------------------------------
# 6. AVISOS (opcional) — te llega un correo si una fuente falla varios días
# ---------------------------------------------------------------------------
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# ---------------------------------------------------------------------------
# 7. DESARROLLO
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Puerto en el que abres la app en tu navegador: http://localhost:8080
WEB_PORT=8080
